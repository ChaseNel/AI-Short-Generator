generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  tier         Tier           @default(FREE)
  projects     VideoProject[]
  accounts     Account[]     
  sessions     Session[]    
  createdAt    DateTime       @default(now())
}


enum Tier {
  FREE
  PRO
}

model VideoProject {
  id         String        @id @default(uuid())
  user       User          @relation(fields: [userId], references: [id])
  userId     String
  title      String
  status     ProjectStatus @default(DRAFT)
  scenes     Scene[]
  jobs       GenerationJob[]
  assets     Asset[]
  createdAt  DateTime      @default(now())
}

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

model Scene {
  id             String        @id @default(uuid())
  videoProject   VideoProject  @relation(fields: [videoProjectId], references: [id])
  videoProjectId String
  order          Int
  visualPrompt   String
  narrationText  String
}

model GenerationJob {
  id             String        @id @default(uuid())
  videoProject   VideoProject  @relation(fields: [videoProjectId], references: [id])
  videoProjectId String
  type           JobType
  status         JobStatus     @default(QUEUED)
  error          String?
  createdAt      DateTime      @default(now())
}

enum JobType {
  STORY
  VIDEO
  VOICE
  SUBTITLES
  SHORT
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Asset {
  id             String        @id @default(uuid())
  videoProject   VideoProject  @relation(fields: [videoProjectId], references: [id])
  videoProjectId String
  type           AssetType
  url            String
  createdAt      DateTime      @default(now())
}

enum AssetType {
  VIDEO_LONG
  VIDEO_SHORT
  AUDIO
  SUBTITLE
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
